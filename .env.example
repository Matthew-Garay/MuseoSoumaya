# Copia este archivo a .env y rellena los valores reales.
# Nunca subas el archivo .env con credenciales reales al repositorio.

# Configuración general del proyecto
APP_NAME=Museo Soumaya - Sitio Web
APP_ENV=local
APP_DEBUG=true

# Configuración de base de datos (si se agrega en el futuro)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=museosoumaya
DB_USERNAME=root
DB_PASSWORD=

# Claves de API y servicios externos
API_KEY=tu_clave_de_api_aqui
